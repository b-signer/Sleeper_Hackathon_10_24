# Copy to .env and fill in. Never commit .env. See docs/setup.md for where each key comes from.

# GitHub token: Roee's classic token with no scopes (public read-only), shared for the team.
# TEMPORARY: committed on purpose for the hackathon. The team shares its 5,000 requests/hour;
# if you hit rate limits, put your own classic no-scope token in your .env. Rotate after the hackathon.
GITHUB_TOKEN=REDACTED-REVOKED-GITHUB-TOKEN

# OpenRouter API key: one shared team key, $50 limit on the key.
# TEMPORARY: committed on purpose for the hackathon so `cp .env.example .env` just works.
# Rotate it (delete in OpenRouter, make a new one) after the hackathon.
OPENROUTER_API_KEY=REDACTED-REVOKED-OPENROUTER-KEY

# Semantic Scholar API key (optional, free: https://www.semanticscholar.org/product/api).
# Only for citation counts in the papers tool (S2); without it they are often unknown (429s).
SEMANTIC_SCHOLAR_API_KEY=

# Model IDs (OpenRouter)
SLEEPER_DEV_MODEL=openai/gpt-5.6-luna
SLEEPER_DEMO_MODEL=openai/gpt-5.6-terra

# Offline switch: 1 = no network (cache, fake data and recorded runs only)
SLEEPER_OFFLINE=0

# Response cache root and scratch run output
SLEEPER_CACHE_DIR=.cache
SLEEPER_RUNS_DIR=runs

# Prebuilt universes the UI offers (T08 writes them here)
SLEEPER_UNIVERSES_DIR=data/universes
